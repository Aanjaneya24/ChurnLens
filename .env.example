# ChurnLens Environment Configuration Template
# Copy this file to .env and customize for local database or custom ports

# Optional SQL Database Connection String (e.g., MySQL, PostgreSQL)
# Format: mysql+pymysql://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=

# Streamlit Server Configuration
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_HEADLESS=true
STREAMLIT_SERVER_ADDRESS=0.0.0.0
